{
  "name": "wow-raid-recorder",
  "version": "1.1.0",
  "description": "WoW Raid Recorder desktop client",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build:css": "tailwindcss -i styles/tailwind.css -o static/css/tailwind.css --minify",
    "build:python": "venv/bin/pyinstaller wow_raid_recorder.spec --noconfirm",
    "build:electron": "electron-builder",
    "build": "npm run build:css && npm run build:python && npm run build:electron"
  },
  "build": {
    "appId": "com.wowraidrecorder",
    "productName": "WoW Raid Recorder",
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/WoWRaidRecorder",
        "to": "backend"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities"
    }
  },
  "devDependencies": {
    "electron": "^44.9.2",
    "electron-builder": "^26.15.3",
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "electron@44.9.2": true
  }
}
