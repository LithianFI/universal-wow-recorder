{
  "name": "wow-raid-recorder",
  "version": "1.0.0",
  "description": "WoW Raid Recorder desktop client",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build:css": "tailwindcss -c tailwind.config.js -i styles/tailwind.css -o static/css/tailwind.css --minify",
    "build:python": "venv/bin/pyinstaller wow_raid_recorder.spec --noconfirm",
    "build:electron": "electron-builder",
    "build": "npm run build:css && npm run build:python && npm run build:electron"
  },
  "build": {
    "appId": "com.wowraidrecorder",
    "productName": "WoW Raid Recorder",
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/WoWRaidRecorder",
        "to": "backend"
      }
    ],
    "linux": {
      "target": ["AppImage"],
      "category": "Utility"
    },
    "win": {
      "target": ["nsis"]
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.utilities"
    }
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "tailwindcss": "3.4.17"
  },
  "allowScripts": {
    "electron@32.3.3": true
  }
}
